# variables related to th e llm instance
LLM_URL=localhost      # cahnge me
LLM_API_KEY=my-api-key # change me
LLM_MODEL=my-model     # change me
# Application
APP_NAME=Decision Service
DEBUG=false

# Database (SQLite)
DB_PATH=/app/data/decision.db

# Service
DECISION_PORT=8090
DECISION_HISTORY_SIZE=20
# Decisions
BLACKLIST_ENABLED=true

# Kafka
KAFKA_HOST=kafka
KAFKA_PORT=9092
KAFKA_INPUT_TOPIC=network.ml.results
#KAFKA_ENABLED=  # true by default
#KAFKA_DEBOUNCE_SECONDS=  # 60 by default

# Auth
DEV_MODE=false
KEYCLOAK_URL=http://keycloak:8080/auth
KEYCLOAK_REALM=aion
